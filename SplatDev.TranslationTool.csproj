<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>SplatDev.TranslationTool</AssemblyName>
		<RootNamespace>SplatDev.TranslationTool</RootNamespace>
		<ApplicationIcon>translate.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="translate.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\translate.png" />
		<Resource Include="Assets\perplexity.png" />
		<Resource Include="Assets\copy.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0-preview.1.25080.5" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0-preview.1.25080.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0-preview.1.25080.5" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0-preview.1.25080.5" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-preview.1.25080.5" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
