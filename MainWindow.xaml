<Window x:Class="SplatDev.TranslationTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:SplatDev.TranslationTool.Converters"
    mc:Ignorable="d"
    Title="AI Translation Tool - Azure AI &amp; Perplexity AI" 
    Height="920" Width="950"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- DataTemplate for language items with availability indicator -->
        <DataTemplate x:Key="LanguageItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="✔" 
                           FontWeight="Bold" 
                           Foreground="#4CAF50"
                           ToolTip="Existing translation file found"
                           Margin="0,0,8,0"
                           FontFamily="Segoe UI Symbol">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{x:Static converters:LanguageAvailabilityConverter.Instance}">
                            <Binding Path="ResourceCode"/>
                            <Binding Path="DataContext.AvailableLanguageCodes" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Grid.Column="1" 
                           Text="{Binding DisplayName}">
                    <TextBlock.FontWeight>
                        <MultiBinding Converter="{x:Static converters:LanguageAvailabilityConverter.Instance}">
                            <Binding Path="ResourceCode"/>
                            <Binding Path="DataContext.AvailableLanguageCodes" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                        </MultiBinding>
                    </TextBlock.FontWeight>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="AI Translation Tool" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- File Selection -->
        <GroupBox Grid.Row="1" Header="Source File (.resx or language_pack-*.xml)" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceFileTextBox" Grid.Column="0" 
                     Text="{Binding SourceFilePath, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="True" Background="White"/>
                <Button Grid.Column="1" Content="Browse..." 
                    Command="{Binding BrowseSourceFileCommand}"/>
            </Grid>
        </GroupBox>

        <!-- Translation Service Selection -->
        <GroupBox Grid.Row="2" Header="Translation Service" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <RadioButton Grid.Row="0" Grid.Column="0" Content="Use Azure AI Translation (Recommended)" 
                         IsChecked="{Binding UseAzureTranslation}" 
                         FontWeight="Bold" Margin="0,0,20,10" VerticalAlignment="Center"/>
                <RadioButton Grid.Row="0" Grid.Column="1" Content="Use Perplexity AI Translation" 
                         IsChecked="{Binding UseAzureTranslation, Converter={StaticResource InverseBooleanConverter}}" 
                         Margin="0,0,0,10" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Auto-detect source language" 
                      IsChecked="{Binding DetectLanguage}" 
                      Margin="0,0,0,0"
                      ToolTip="When enabled, automatically detects the source language instead of assuming English"/>
                <Label Grid.Row="1" Grid.Column="3" Content="Rate Limit Delay (ms):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="4" 
                         Text="{Binding RateLimitDelay, UpdateSourceTrigger=PropertyChanged}"
                         Background="White"
                         ToolTip="Delay between API requests to avoid rate limits"/>
            </Grid>
        </GroupBox>

        <!-- Language Selection -->
        <GroupBox Grid.Row="3" Header="Target Language" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="LanguageComboBox" 
                      ItemsSource="{Binding AvailableLanguages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      ItemTemplate="{StaticResource LanguageItemTemplate}"
                      MinWidth="300"/>
                <Button Content="Translate All" 
                    Command="{Binding TranslateAllCommand}"
                    IsEnabled="{Binding CanTranslate}"
                    Background="#4CAF50" Foreground="Black" FontWeight="Bold"/>
                <Button Content="Stop" 
                    Command="{Binding StopTranslationCommand}"
                    IsEnabled="{Binding IsTranslating}"
                    Background="#F44336" Foreground="Black"/>
                <Button Content="Edit Translations" 
                    Command="{Binding OpenEditorCommand}"
                    IsEnabled="{Binding CanOpenEditor}"
                    Background="#2196F3" Foreground="Black" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>


        <!-- Translation Progress -->
        <GroupBox Grid.Row="4" Header="Translation Progress" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Progress Bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,5"/>
                    <ProgressBar Height="25" 
                                 Value="{Binding ProgressValue}" 
                                 Maximum="{Binding ProgressMax}"
                                 Foreground="#2196F3"/>
                </StackPanel>

                <!-- Translation Log -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding TranslationLog}"
                         x:Name="LogListBox"
                         Background="White"
                         BorderBrush="#DDD"
                         FontFamily="Consolas"
                         FontSize="11"/>
            </Grid>
        </GroupBox>

        <!-- API Settings -->
        <GroupBox Grid.Row="5" Header="API Credentials" Margin="0,10,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Azure AI Translation Settings -->
                <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="#F8F9FA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" 
                                   Text="Azure AI Translation" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="API Key:" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="AzureApiKeyPasswordBox" 
                                     PasswordChanged="AzureApiKeyPasswordBox_PasswordChanged"
                                     Background="White" Margin="0,0,5,0" Height="29"/>
                        <Label Grid.Row="1" Grid.Column="2" Content="Region:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="3" 
                                 Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White"
                                 ToolTip="e.g., eastus, westeurope"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Endpoint:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" 
                                 Text="{Binding AzureEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" Margin="0,5,0,0"
                                 ToolTip="Azure Translation endpoint URL (e.g., https://api.cognitive.microsofttranslator.com or your Azure AI Translation Foundry endpoint)"/>
                    </Grid>
                </Border>

                <!-- Perplexity AI Settings -->
                <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="#F8F9FA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                   Text="Perplexity AI" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="API Key:" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PerplexityApiKeyPasswordBox" 
                                     PasswordChanged="PerplexityApiKeyPasswordBox_PasswordChanged"
                                     Background="White"/>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Status Bar -->
        <Border Grid.Row="6" Background="#333" Margin="0,10,0,0" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
