<Window x:Class="SplatDev.TranslationTool.TranslationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Translation Editor"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Translation Editor" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding TargetLanguage.DisplayName, StringFormat='Target Language: {0}'}"
                       FontSize="14" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Width="250" Padding="8,5" Background="White"/>
                <CheckBox Content="Modified only" IsChecked="{Binding ShowOnlyModified}"
                          VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <!-- Actions -->
            <Button Grid.Column="2" Content="Retranslate Empty/Modified"
                    Command="{Binding RetranslateAllModifiedCommand}"
                    Background="#FF9800" Foreground="Black" FontWeight="Bold"
                    Padding="15,8" Margin="5,0"/>
            <Button Grid.Column="3" Content="Save All"
                    Command="{Binding SaveTranslationsCommand}"
                    Background="#4CAF50" Foreground="Black" FontWeight="Bold"
                    Padding="15,8" Margin="5,0"/>
        </Grid>

        <!-- Translation Grid -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Grid Grid.Row="0" Background="#E0E0E0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Key" FontWeight="Bold" Padding="10,8" />
                    <TextBlock Grid.Column="1" Text="Original (English)" FontWeight="Bold" Padding="10,8"/>
                    <TextBlock Grid.Column="2" Text="Translation" FontWeight="Bold" Padding="10,8"/>
                    <TextBlock Grid.Column="3" Text="Actions" FontWeight="Bold" Padding="10,8" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Entries List -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding FilteredEntries}"
                           d:ItemsSource="{d:SampleData ItemCount=5}"
                          SelectedItem="{Binding SelectedEntry}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                    <Setter Property="Background" Value="#FFF8E1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <!-- Key -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Key}"
                                           Padding="10,8"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Key}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                                <!-- Original Value -->
                                <Border Grid.Column="1" BorderBrush="#EEE" BorderThickness="1,0,1,0">
                                    <TextBox Text="{Binding OriginalValue, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#FAFAFA"
                                             BorderThickness="0"
                                             Padding="10,8"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             MaxHeight="100"/>
                                </Border>

                                <!-- Translated Value -->
                                <Border Grid.Column="2" BorderBrush="#EEE" BorderThickness="0,0,1,0">
                                    <TextBox Text="{Binding TranslatedValue, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Padding="10,8"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             MaxHeight="100"
                                             Background="White"/>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.RetranslateEntryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Translate/Re-Translate with AI"
                                        Width="20" Height="20" 
                                        MinHeight="0" MinWidth="0"
                                        Padding="0"
                                        Margin="2"
                                        Background="Transparent" 
                                        BorderThickness="0" >
                                        <Button.Content>
                                            <Image Source="/Assets/translate.png" Width="20" Height="20"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Command="{Binding DataContext.CopyOriginalToTranslationCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" 
                                        HorizontalAlignment="Left"
                                        ToolTip="Copy original to translation"
                                        Width="20" Height="20" 
                                        MinHeight="0" MinWidth="0"
                                        Padding="0"
                                        Margin="2"
                                        Background="Transparent" 
                                        BorderThickness="0">
                                        <Button.Content>
                                            <Image Source="/Assets/copy.png" Width="20" Height="20"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>

                                <!-- Loading Indicator -->
                                <Border Grid.Column="0" Grid.ColumnSpan="4"
                                        Background="#80FFFFFF"
                                        Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Translating..."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" Foreground="#2196F3"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#333" Margin="0,10,0,0" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
